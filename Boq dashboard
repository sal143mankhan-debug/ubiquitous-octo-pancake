            document.querySelectorAll('.tab-button').forEach(btn => {
                btn.classList.remove('active');
            });
            
            // Show selected tab
            document.getElementById(tabName).classList.add('active');
            event.target.classList.add('active');
        }

        // Filter BOQ
        function filterBOQ() {
            const searchTerm = document.getElementById('boqSearch').value.toLowerCase();
            const rows = document.querySelectorAll('.boq-row');
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        }

        function filterByRisk(risk) {
            const rows = document.querySelectorAll('.boq-row');
            const buttons = document.querySelectorAll('.filter-button');
            
            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            
            rows.forEach(row => {
                if (risk === 'all') {
                    row.style.display = '';
                } else {
                    row.style.display = row.classList.contains(`risk-${risk}`) ? '' : 'none';
                }
            });
        }

        // Scenario Simulator
        function updateScenario() {
            const baseContract = 13115816; // Quoted value in rupees
            const targetMargin = 0.125;
            
            // Get input values
            const materialVar = parseFloat(document.getElementById('materialVar').value) / 100;
            const labourVar = parseFloat(document.getElementById('labourVar').value) / 100;
            const delayDays = parseFloat(document.getElementById('delayDays').value);
            const wastage = parseFloat(document.getElementById('wastage').value) / 100;
            const billingEff = parseFloat(document.getElementById('billingEff').value) / 100;
            const riskProb = parseFloat(document.getElementById('riskProb').value) / 100;
            
            // Update display values
            document.getElementById('materialVarValue').textContent = (materialVar * 100).toFixed(1) + '%';
            document.getElementById('labourVarValue').textContent = (labourVar * 100).toFixed(1) + '%';
            document.getElementById('delayValue').textContent = delayDays + ' days';
            document.getElementById('wastageValue').textContent = (wastage * 100).toFixed(1) + '%';
            document.getElementById('billingValue').textContent = (billingEff * 100).toFixed(0) + '%';
            document.getElementById('riskValue').textContent = (riskProb * 100).toFixed(0) + '%';
            
            // Calculate impacts
            const materialCost = baseContract * 0.45; // 45% of contract
            const labourCost = baseContract * 0.30; // 30% of contract
            const otherCosts = baseContract * 0.25; // 25% of contract
            
            const materialImpact = materialCost * materialVar;
            const labourImpact = labourCost * labourVar;
            const delayImpact = delayDays * 15000; // ₹15K per day overhead
            const wastageImpact = materialCost * (wastage - 0.05); // Base wastage 5%
            const billingImpact = baseContract * (1 - billingEff) * 0.20; // 20% profit impact
            const riskImpact = 2380000 * riskProb; // Risk exposure
            
            const totalImpact = materialImpact + labourImpact + delayImpact + wastageImpact + billingImpact + riskImpact;
            const baseProfitexpected = baseContract * targetMargin;
            const adjustedProfit = baseProfit - totalImpact;
            const adjustedMargin = (adjustedProfit / baseContract) * 100;
            
            // Display results
            const resultsHTML = `
                <div class="scenario-result-card">
                    <div class="scenario-result-label">Adjusted Profit</div>
                    <div class="scenario-result-value" style="color: ${adjustedProfit >= 0 ? 'var(--accent-green)' : 'var(--accent-red)'}">
                        ₹${(adjustedProfit / 100000).toFixed(2)}L
                    </div>
                </div>
                <div class="scenario-result-card">
                    <div class="scenario-result-label">Margin %</div>
                    <div class="scenario-result-value" style="color: ${adjustedMargin >= 12.5 ? 'var(--accent-green)' : adjustedMargin >= 8 ? 'var(--accent-amber)' : 'var(--accent-red)'}">
                        ${adjustedMargin.toFixed(2)}%
                    </div>
                </div>
                <div class="scenario-result-card">
                    <div class="scenario-result-label">Total Impact</div>
                    <div class="scenario-result-value" style="color: var(--accent-red)">
                        -₹${(totalImpact / 100000).toFixed(2)}L
                    </div>
                </div>
                <div class="scenario-result-card">
                    <div class="scenario-result-label">vs Target</div>
                    <div class="scenario-result-value" style="color: ${adjustedProfit >= baseProfit ? 'var(--accent-green)' : 'var(--accent-red)'}">
                        ${adjustedProfit >= baseProfit ? '+' : ''}${((adjustedProfit - baseProfit) / 100000).toFixed(2)}L
                    </div>
                </div>
                <div class="scenario-result-card">
                    <div class="scenario-result-label">Risk Rating</div>
                    <div class="scenario-result-value" style="color: ${adjustedMargin >= 12 ? 'var(--accent-green)' : adjustedMargin >= 8 ? 'var(--accent-amber)' : 'var(--accent-red)'}; font-size: 1.25rem;">
                        ${adjustedMargin >= 12 ? '✓ LOW' : adjustedMargin >= 8 ? '⚠ MEDIUM' : '✗ HIGH'}
                    </div>
                </div>
                <div class="scenario-result-card">
                    <div class="scenario-result-label">Final Contract Value</div>
                    <div class="scenario-result-value">
                        ₹${(baseContract / 10000000).toFixed(2)}Cr
                    </div>
                </div>
            `;
            
            document.getElementById('scenarioResults').innerHTML = resultsHTML;
        }

        function loadPreset(type) {
            const presets = {
                best: { material: -5, labour: -3, delay: 0, wastage: 3, billing: 100, risk: 0 },
                realistic: { material: 3, labour: 8, delay: 15, wastage: 5, billing: 95, risk: 10 },
                worst: { material: 12, labour: 18, delay: 60, wastage: 10, billing: 80, risk: 35 },
                reset: { material: 0, labour: 0, delay: 0, wastage: 5, billing: 95, risk: 10 }
            };
            
            const preset = presets[type];
            document.getElementById('materialVar').value = preset.material;
            document.getElementById('labourVar').value = preset.labour;
            document.getElementById('delayDays').value = preset.delay;
            document.getElementById('wastage').value = preset.wastage;
            document.getElementById('billingEff').value = preset.billing;
            document.getElementById('riskProb').value = preset.risk;
            
            updateScenario();
