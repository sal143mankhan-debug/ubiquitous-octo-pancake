<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BOQ Profit Control Dashboard | Workshop Bulandshahr</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Work+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-primary: #0a0e1a;
            --bg-secondary: #141925;
            --bg-tertiary: #1e2433;
            --bg-card: #242b3d;
            --text-primary: #e8eaed;
            --text-secondary: #9aa5b8;
            --text-muted: #6b7280;
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --accent-amber: #f59e0b;
            --accent-blue: #3b82f6;
            --accent-purple: #8b5cf6;
            --border-color: #2d3748;
            --success: #059669;
            --warning: #d97706;
            --danger: #dc2626;
        }

        body {
            font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(135deg, var(--bg-primary) 0%, #0d1220 100%);
            color: var(--text-primary);
            line-height: 1.6;
            min-height: 100vh;
        }

        .dashboard-container {
            max-width: 1920px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* Header */
        .dashboard-header {
            background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .dashboard-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple), var(--accent-green));
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 2rem;
        }

        .project-info h1 {
            font-size: 1.875rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
        }

        .project-meta {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
            font-size: 0.875rem;
            color: var(--text-secondary);
            font-family: 'JetBrains Mono', monospace;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .meta-label {
            color: var(--text-muted);
        }

        .status-badges {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .badge {
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.813rem;
            font-weight: 600;
            font-family: 'JetBrains Mono', monospace;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .badge-warning {
            background: rgba(245, 158, 11, 0.15);
            color: var(--accent-amber);
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .badge-info {
            background: rgba(59, 130, 246, 0.15);
            color: var(--accent-blue);
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.6; transform: scale(0.9); }
        }

        /* KPI Cards */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .kpi-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .kpi-card:hover {
            transform: translateY(-2px);
            border-color: var(--accent-blue);
            box-shadow: 0 8px 24px rgba(59, 130, 246, 0.15);
        }

        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--kpi-color, var(--accent-blue));
        }

        .kpi-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
        }

        .kpi-title {
            font-size: 0.813rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
        }

        .kpi-value {
            font-size: 2rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            color: var(--text-primary);
            margin: 0.5rem 0;
        }

        .kpi-change {
            font-size: 0.875rem;
            font-family: 'JetBrains Mono', monospace;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .kpi-change.positive {
            color: var(--accent-green);
        }

        .kpi-change.negative {
            color: var(--accent-red);
        }

        .kpi-subtitle {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 0.5rem;
        }

        /* Tab Navigation */
        .tab-navigation {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 0.5rem;
            margin-bottom: 2rem;
            display: flex;
            gap: 0.5rem;
            overflow-x: auto;
        }

        .tab-button {
            padding: 0.75rem 1.5rem;
            background: transparent;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 600;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .tab-button:hover {
            background: var(--bg-tertiary);
            color: var(--text-primary);
        }

        .tab-button.active {
            background: var(--accent-blue);
            color: white;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Chart Container */
        .chart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .chart-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
        }

        .chart-title {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--text-primary);
        }

        .chart-wrapper {
            position: relative;
            height: 300px;
        }

        /* Heat Map */
        .heatmap-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .heatmap-grid {
            display: grid;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .heatmap-row {
            display: grid;
            grid-template-columns: 60px 1fr 120px 120px 100px;
            gap: 0.5rem;
            align-items: center;
        }

        .heatmap-header {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            padding: 0.75rem;
            background: var(--bg-tertiary);
            border-radius: 6px;
        }

        .heatmap-cell {
            padding: 0.75rem;
            background: var(--bg-tertiary);
            border-radius: 6px;
            font-size: 0.875rem;
            border: 1px solid var(--border-color);
            transition: all 0.2s ease;
        }

        .heatmap-cell.item-name {
            font-weight: 500;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .heatmap-cell.risk-score {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            text-align: center;
        }

        .risk-critical {
            background: rgba(220, 38, 38, 0.2);
            border-color: var(--danger);
            color: var(--accent-red);
        }

        .risk-high {
            background: rgba(245, 158, 11, 0.2);
            border-color: var(--warning);
            color: var(--accent-amber);
        }

        .risk-medium {
            background: rgba(59, 130, 246, 0.2);
            border-color: var(--accent-blue);
            color: var(--accent-blue);
        }

        .risk-low {
            background: rgba(16, 185, 129, 0.2);
            border-color: var(--success);
            color: var(--accent-green);
        }

        /* BOQ Table */
        .boq-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .boq-controls {
            padding: 1.5rem;
            background: var(--bg-tertiary);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .search-box {
            flex: 1;
            min-width: 250px;
            position: relative;
        }

        .search-box input {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.5rem;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 0.875rem;
            transition: all 0.3s ease;
        }

        .search-box input:focus {
            outline: none;
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .filter-group {
            display: flex;
            gap: 0.5rem;
        }

        .filter-button {
            padding: 0.75rem 1rem;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.813rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .filter-button:hover {
            background: var(--bg-tertiary);
            border-color: var(--accent-blue);
            color: var(--text-primary);
        }

        .filter-button.active {
            background: var(--accent-blue);
            color: white;
            border-color: var(--accent-blue);
        }

        .boq-table-wrapper {
            overflow-x: auto;
            max-height: 800px;
            overflow-y: auto;
        }

        .boq-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

        .boq-table thead {
            position: sticky;
            top: 0;
            background: var(--bg-tertiary);
            z-index: 10;
        }

        .boq-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--text-secondary);
            border-bottom: 2px solid var(--border-color);
            white-space: nowrap;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .boq-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
        }

        .boq-table tbody tr {
            transition: background 0.2s ease;
        }

        .boq-table tbody tr:hover {
            background: rgba(59, 130, 246, 0.05);
        }

        .item-number {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            color: var(--text-muted);
        }

        .item-description {
            max-width: 400px;
            font-size: 0.813rem;
            line-height: 1.5;
        }

        .quantity-cell {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
        }

        .amount-cell {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            text-align: right;
        }

        .margin-positive {
            color: var(--accent-green);
        }

        .margin-negative {
            color: var(--accent-red);
        }

        .risk-indicator {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 0.5rem;
        }

        /* SOP Cards */
        .sop-grid {
            display: grid;
            gap: 1.5rem;
        }

        .sop-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-left: 4px solid var(--sop-color);
            border-radius: 12px;
            padding: 1.5rem;
        }

        .sop-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
        }

        .sop-item-number {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        .sop-risk-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            font-family: 'JetBrains Mono', monospace;
        }

        .sop-title {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--text-primary);
        }

        .sop-section {
            margin-bottom: 1.5rem;
        }

        .sop-section-title {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
        }

        .sop-list {
            list-style: none;
            padding: 0;
        }

        .sop-list li {
            padding: 0.5rem 0;
            padding-left: 1.5rem;
            position: relative;
            font-size: 0.875rem;
            line-height: 1.6;
        }

        .sop-list li::before {
            content: '→';
            position: absolute;
            left: 0;
            color: var(--accent-blue);
            font-weight: 600;
        }

        .sop-warning {
            background: rgba(245, 158, 11, 0.1);
            border-left: 3px solid var(--accent-amber);
            padding: 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            margin-top: 1rem;
        }

        .sop-warning strong {
            color: var(--accent-amber);
        }

        /* Scenario Simulator */
        .scenario-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .scenario-controls {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .scenario-input-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .scenario-label {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-secondary);
        }

        .scenario-input {
            padding: 0.75rem 1rem;
            background: var(--bg-tertiary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 0.875rem;
            font-family: 'JetBrains Mono', monospace;
        }

        .scenario-input:focus {
            outline: none;
            border-color: var(--accent-blue);
        }

        .scenario-results {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 2rem;
        }

        .scenario-result-card {
            background: var(--bg-tertiary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1.5rem;
            text-align: center;
        }

        .scenario-result-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .scenario-result-value {
            font-size: 1.5rem;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
            color: var(--text-primary);
        }

        .scenario-button {
            padding: 1rem 2rem;
            background: var(--accent-blue);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.875rem;
            font-weight: 600;
            transition: all 0.3s ease;
            margin-top: 1rem;
        }

        .scenario-button:hover {
            background: #2563eb;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .dashboard-container {
                padding: 1rem;
            }

            .kpi-grid {
                grid-template-columns: 1fr;
            }

            .chart-grid {
                grid-template-columns: 1fr;
            }

            .boq-controls {
                flex-direction: column;
            }

            .filter-group {
                width: 100%;
                overflow-x: auto;
            }
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: var(--accent-blue);
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-secondary);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--bg-tertiary);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--border-color);
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <div class="project-info">
                    <h1>🔥 BOQ Profit Control Dashboard</h1>
                    <div class="project-meta">
                        <div class="meta-item">
                            <span class="meta-label">Project:</span>
                            <span>Workshop Bulandshahr Construction</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Contractor:</span>
                            <span>M/S S R INFRACONSTRUCTION PVT LTD</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Tender:</span>
                            <span>66/ECDC/GZB/2024-25</span>
                        </div>
                    </div>
                </div>
                <div class="status-badges">
                    <div class="badge badge-success">
                        <span class="pulse-dot"></span>
                        9.70% Discount Won
                    </div>
                    <div class="badge badge-warning">
                        <span class="pulse-dot"></span>
                        17 Critical Items
                    </div>
                    <div class="badge badge-info">
                        179 Line Items
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="kpi-grid">
            <div class="kpi-card" style="--kpi-color: var(--accent-blue)">
                <div class="kpi-header">
                    <div class="kpi-title">Estimated Value</div>
                </div>
                <div class="kpi-value">₹1.45 Cr</div>
                <div class="kpi-subtitle">Base BOQ Amount</div>
            </div>
            
            <div class="kpi-card" style="--kpi-color: var(--accent-green)">
                <div class="kpi-header">
                    <div class="kpi-title">Quoted Value</div>
                </div>
                <div class="kpi-value">₹1.31 Cr</div>
                <div class="kpi-change positive">
                    ↓ ₹14.09L (9.70%)
                </div>
            </div>
            
            <div class="kpi-card" style="--kpi-color: var(--accent-purple)">
                <div class="kpi-header">
                    <div class="kpi-title">Target Margin</div>
                </div>
                <div class="kpi-value">12.5%</div>
                <div class="kpi-change positive">
                    ₹16.39L Projected Profit
                </div>
            </div>
            
            <div class="kpi-card" style="--kpi-color: var(--accent-amber)">
                <div class="kpi-header">
                    <div class="kpi-title">Risk Exposure</div>
                </div>
                <div class="kpi-value">₹23.8L</div>
                <div class="kpi-subtitle">17 High-Risk Items</div>
            </div>

            <div class="kpi-card" style="--kpi-color: var(--accent-red)">
                <div class="kpi-header">
                    <div class="kpi-title">Critical Watchlist</div>
                </div>
                <div class="kpi-value">5 Items</div>
                <div class="kpi-subtitle">Requiring Daily Monitoring</div>
            </div>

            <div class="kpi-card" style="--kpi-color: #06b6d4">
                <div class="kpi-header">
                    <div class="kpi-title">Best Case Margin</div>
                </div>
                <div class="kpi-value">18.2%</div>
                <div class="kpi-change positive">
                    +5.7% above target
                </div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="tab-navigation">
            <button class="tab-button active" onclick="switchTab('overview')">📊 Overview</button>
            <button class="tab-button" onclick="switchTab('heatmap')">🔥 Profit Heat Map</button>
            <button class="tab-button" onclick="switchTab('boq')">📋 Full BOQ Analysis</button>
            <button class="tab-button" onclick="switchTab('sop')">⚡ Execution SOPs</button>
            <button class="tab-button" onclick="switchTab('scenario')">🎯 Scenario Simulator</button>
        </div>

        <!-- Overview Tab -->
        <div id="overview" class="tab-content active">
            <div class="chart-grid">
                <div class="chart-container">
                    <h3 class="chart-title">Margin Distribution by Category</h3>
                    <div class="chart-wrapper">
                        <canvas id="marginChart"></canvas>
                    </div>
                </div>
                
                <div class="chart-container">
                    <h3 class="chart-title">Risk Exposure Analysis</h3>
                    <div class="chart-wrapper">
                        <canvas id="riskChart"></canvas>
                    </div>
                </div>
            </div>

